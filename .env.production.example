# Public build configuration only. Use endpoints from the dedicated production
# Neon branch. OAuth client secrets and SMTP credentials belong in Neon.
VITE_NEON_AUTH_URL_PRODUCTION=
VITE_NEON_DATA_API_URL_PRODUCTION=
VITE_NEON_DEPLOYMENT_ENV=production
VITE_NEON_BRANCH=production
VITE_NEON_GOOGLE_OAUTH_ENABLED=false
VITE_NEON_SIGN_UP_ENABLED=false
# Worker/ingestion runtime: live production endpoints only. Supply the free
# SAM.gov key via `npx wrangler secret put SAM_GOV_API_KEY`, never in [vars].
NODE_ENV=production
SAM_GOV_API_KEY=

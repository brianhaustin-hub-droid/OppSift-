# These are public service URLs, not credentials. The app uses Neon Managed
# Better Auth and the Neon Data API; PostgreSQL RLS is mandatory for every
# table exposed to the Data API.
VITE_NEON_AUTH_URL=
VITE_NEON_DATA_API_URL=
VITE_NEON_DEPLOYMENT_ENV=production
VITE_NEON_BRANCH=production
VITE_NEON_GOOGLE_OAUTH_ENABLED=true
VITE_NEON_SIGN_UP_ENABLED=true

# Never add a DATABASE_URL, OAuth client secret, or other private credential
# to VITE_* variables. Set Google OAuth enabled only after configuring its
# client credentials in Neon; email delivery is configured in Neon as well.
# Preview and production builds require a matching deployment environment
# and branch label; see .env.preview.example and .env.production.example.

# --- Production data source endpoints (public open-data APIs, no key needed) ---
# Grants.gov Search API - anonymous, used by the grants-gov-search connector.
GRANTS_GOV_API_URL=https://api.grants.gov/v1/api
# TED (EU) Tenders Electronic Daily search API - anonymous.
TED_SEARCH_API_URL=https://api.ted.europa.eu/v3/notices/search
# World Bank procurement notices API - anonymous.
WORLD_BANK_PROCUREMENT_API_URL=https://search.worldbank.org/api/procnotices
# USAspending Contracts Finder API - anonymous.
CONTRACTS_FINDER_API_URL=https://api.usaspending.gov

# --- Optional free API keys ---
# SAM.gov Opportunities API: request a free key at https://api.sam.gov
# (Sign Up -> Get API Key). Without it the SAM.gov connector stays inactive
# and logs a clear "SAM.gov API key is not configured" blocker; every other
# source keeps running. Supply it to the worker with:
#   npx wrangler secret put SAM_GOV_API_KEY
SAM_GOV_API_KEY=

# --- Public tender API read tokens ---
# Gambia GPPA publishes its tender listing through the Strapi CMS API at
# https://cms.gppa.gm/api. The public gppa.gm site uses a read-only bearer
# token; copy that value into a Worker secret (never commit it):
#   npx wrangler secret put GPPA_CMS_API_TOKEN
GPPA_CMS_API_TOKEN=

# The ingestion orchestrator runs against live production endpoints in every
# environment; there is no mock or sandbox data mode.
NODE_ENV=production
